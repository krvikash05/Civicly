# Local B01 foundation. Generate ignored Browser secrets with make configure.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=civicly_knowledge
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_CONNECT_TIMEOUT_SECONDS=2
FALKORDB_SOCKET_TIMEOUT_SECONDS=3
FALKORDB_QUERY_TIMEOUT_MS=1000
FALKORDB_BROWSER_PORT=3000
# AUTH_SECRET and ENCRYPTION_KEY are generated in .env, never committed.
# B10 live provider; keep credentials only in ignored .env. No live OpenAI adapter claim.
CIVICLY_LLM_PROVIDER=gemini
CIVICLY_LLM_MODEL=gemini-3.8-flash
CIVICLY_LLM_TIMEOUT=45
GEMINI_API_KEY=

# B10-O: credentials never grant permission. CLI --live for one exact case is required.
CIVICLY_AI_PROJECT_LIMIT_USD=6
CIVICLY_LLM_TRANSIENT_RETRIES=2
CIVICLY_LLM_RETRY_WAIT_BUDGET=8
# Optional verified pricing schedule: CIVICLY_AI_PRICING_FILE=/absolute/path/to/schedule.json
# Per-investigation default $.15; explicit CLI --max-cost-usd raises a particular approved case.
