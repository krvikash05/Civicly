{
  "version": 1,
  "registry_version": 3,
  "migration": "0001",
  "municipality_id": "demo-city",
  "write_targets": "canonical civicly_knowledge or validated B08 UUID test graphs only; all retained sources read-only",
  "external_identity": [
    "municipality_id",
    "source_kind",
    "source_id",
    "external_record_id"
  ],
  "normalization": "Strict JSON, NFKC+trim case-sensitive IDs, whitespace-normalized descriptions, aware ISO timestamps to UTC; raw first submission retained; decimal arithmetic for canonical quantities/units also used by request hash, first original preserved on resume",
  "matching": {
    "same_event_hours": 24,
    "criteria": [
      "issue_type",
      "subtype",
      "location_id",
      "explicit_asset_set",
      "overlapping_occurrence_interval",
      "compatible_source_event_reference"
    ],
    "no_asset_match": "requires attributed explicit event reference; no proximity-only match",
    "patterns": [
      "SINGLE_EVENT",
      "PERSISTENT",
      "RECURRENT",
      "CROSS_CATEGORY"
    ],
    "resolution": "dated ENDED interval permits recurrence context; work-order completion is not resolution; missing dates remain indeterminate"
  },
  "storage": "Existing UNVERIFIED Evidence COMPLAINT_INTAKE/GROUPING_CORRECTION summary JSON journal (64KiB), no registry/migration additions",
  "consistency": "PREPARED journal separate controlled commit; domain batch+COMMITTED receipt+revision/audit atomic in one B03 fenced query. Explicit retry/reconcile only; not B15 event outbox",
  "limits": {
    "input_bytes": 32768,
    "journal_bytes": 65536,
    "asset_ids": 3,
    "evidence_ids": 10,
    "incident_scan": 100,
    "context_edges": 400,
    "report_journals": 200,
    "topology_hops": 4,
    "query_timeout_ms": 1000,
    "context_wall_seconds": 8,
    "context_queries": 96,
    "incoming_dependency_roots_per_asset": 6,
    "dependency_roots": 9,
    "reconciliation_journals": 100,
    "detailed_related_explanations": 20,
    "proof_paths": 100
  },
