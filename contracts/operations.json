  "binding": "Full exact task/action/target/department/assignee scope, current plan/version/hash, authenticated decision and current proof. B12 draft immutable; native lifecycle independently audited.",
  "conditional": "Human may approve CONDITIONAL proposal; UNMET causal/safety or non-COMPLETED dependencies block work-order creation. No waiver/fabricated finding.",
  "rejection": "Exact immutable current scope and CAS still required; current causal/source validity need not be repaired to reject. Binding-only validation recorded explicitly.",
  "auth": "Private SQLite PBKDF2-HMAC-SHA256600000/random16byte salts, signed30minute revocable sessions; caller roles never trusted. Existing5source operators plus private-admin and water-utility lead metadata, four roles.",
  "storage": "Compatible additive0005 companion indexes; one existing fenced mutation couples native Approval/WorkOrder/StatusEvent/DomainEvent/audit/request ledger. No cross-graph transaction claim.",
  "b13_transitions": [
    "AUTHORIZED->ASSIGNED",
    "AUTHORIZED->CANCELLED",
    "ASSIGNED->CANCELLED"
  ],
  "excluded": [
    "event delivery/worker",
    "API",
    "frontend",
    "live provider"
  ],
