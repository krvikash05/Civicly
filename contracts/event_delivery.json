        "default": null,
        "title": "Actor Id"
      },
      "actor_role": {
        "anyOf": [
          {
            "enum": [
              "ANALYST",
              "DEPARTMENT_LEAD",
              "APPROVER",
              "ADMIN",
              "SYSTEM"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Actor Role"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      }
    },
    "required": [
      "id",
      "type",
      "entity_id",
      "aggregate_revision",
      "occurred_at",
      "payload_schema_version",
      "source_kind",
      "idempotency_key"
