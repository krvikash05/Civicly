            "title": "Kind",
            "type": "string"
          },
          "status": {
            "enum": [
              "MET",
              "UNMET"
            ],
            "title": "Status",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 12,
            "title": "Evidence Ids",
            "type": "array"
          },
          "depends_on_task_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Depends On Task Id"
          }
        },
        "required": [
          "kind",
          "status"
        ],
        "title": "Prerequisite",
        "type": "object"
      },
      "Remediation": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "SUPPORTED_NOW",
              "CONDITIONAL"
            ],
            "title": "Mode",
            "type": "string"
          },
          "conditions": {
            "items": {
              "$ref": "#/$defs/Prerequisite"
            },
            "maxItems": 4,
            "minItems": 2,
            "title": "Conditions",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "conditions"
        ],
        "title": "Remediation",
        "type": "object"
      },
      "TaskDraft": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "action_type": {
            "enum": [
              "INSPECTION",
              "DRAIN_BLOCKAGE_CLEARANCE",
              "SUBGRADE_REPAIR",
              "MISSED_PICKUP_RECOVERY",
              "UTILITY_ISOLATION",
              "UTILITY_LEAK_REPAIR"
            ],
            "title": "Action Type",
            "type": "string"
          },
          "remediation": {
            "anyOf": [
              {
                "$ref": "#/$defs/Remediation"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "target_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Target Ids",
            "type": "array"
          },
          "department_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Department Id",
            "type": "string"
          },
          "priority": {
            "enum": [
              "LOW",
              "MODERATE",
              "HIGH",
              "CRITICAL"
            ],
            "title": "Priority",
            "type": "string"
          },
          "prerequisites": {
            "items": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Prerequisites",
            "type": "array"
          },
          "depends_on": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 12,
            "title": "Depends On",
            "type": "array"
          },
          "evidence_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "assessment_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Assessment Ids",
            "type": "array"
          },
          "procedure_citation": {
            "$ref": "#/$defs/Citation"
          },
          "expected_outcome": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Expected Outcome",
            "type": "string"
          },
          "verification_criteria": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Verification Criteria",
            "type": "string"
          },
          "risks": {
            "items": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Risks",
            "type": "array"
          }
        },
        "required": [
          "id",
          "action_type",
          "target_ids",
          "department_id",
          "priority",
          "prerequisites",
          "evidence_ids",
          "assessment_ids",
          "procedure_citation",
          "expected_outcome",
          "verification_criteria",
          "risks"
        ],
        "title": "TaskDraft",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "investigation_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Investigation Id",
        "type": "string"
      },
      "issue": {
        "enum": [
          "WATERLOGGING",
          "ROAD_DAMAGE",
          "WASTE_ACCUMULATION"
        ],
        "title": "Issue",
        "type": "string"
      },
      "version": {
        "maximum": 100,
        "minimum": 1,
        "title": "Version",
        "type": "integer"
      },
      "previous_plan_id": {
        "anyOf": [
          {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Previous Plan Id"
      },
      "simulation_mode": {
        "const": "SIMULATED",
        "default": "SIMULATED",
        "title": "Simulation Mode",
        "type": "string"
      },
      "basis": {
        "items": {
          "$ref": "#/$defs/Basis"
        },
        "maxItems": 10,
        "minItems": 2,
        "title": "Basis",
        "type": "array"
      },
      "evidence_ids": {
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 30,
        "minItems": 1,
        "title": "Evidence Ids",
        "type": "array"
      },
      "tasks": {
        "items": {
          "$ref": "#/$defs/TaskDraft"
        },
        "maxItems": 12,
        "minItems": 1,
        "title": "Tasks",
        "type": "array"
      },
      "expected_outcomes": {
        "items": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 8,
        "minItems": 1,
        "title": "Expected Outcomes",
        "type": "array"
      },
      "risks": {
        "items": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 8,
        "minItems": 1,
        "title": "Risks",
        "type": "array"
      },
      "uncertainties": {
        "items": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 12,
        "minItems": 1,
        "title": "Uncertainties",
        "type": "array"
      },
      "monitoring": {
        "$ref": "#/$defs/Monitoring"
      }
