    "title": "PlanDraft",
    "type": "object"
  },
  "receipt_schema": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "integer"
      },
      "plan_hash": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Plan Hash",
        "type": "string"
      },
      "status": {
        "const": "DRAFT",
        "default": "DRAFT",
        "title": "Status",
        "type": "string"
      },
      "simulation_mode": {
        "const": "SIMULATED",
        "default": "SIMULATED",
        "title": "Simulation Mode",
        "type": "string"
      },
      "approved": {
        "const": false,
        "default": false,
        "title": "Approved",
        "type": "boolean"
      },
      "executable": {
        "const": false,
        "default": false,
        "title": "Executable",
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "version",
      "plan_hash"
    ],
    "title": "PlanReceipt",
    "type": "object"
  },
  "reference_rules": "latest immutable assessments from investigated hypotheses, attributed evidence membership, temporally visible investigation assets/hypothesis concern targets, verified single MAINTAINED_BY; unknown/conflict blocks",
  "procedure_rules": "Exact B11 canonical graph/Document/KnowledgeProcedure/version/chunk/source hash pointer; source-reviewed PROPOSED never verified policy; document owner is not execution assignment; revoked/superseded blocks",
  "storage": "registryv3/0001\u20130003 unchanged; additive0004 companion plus actual ResolutionPlan/ActionTask/native DAG/assignment/target edges in one fenced repository commit. Immutable versions, request hash replay, no partial acknowledgment",
  "runtime": "RECOMMEND {plan_draft}; bounded sanitized feedback persisted for safe rejected drafts/pre-write dependency errors. Unsafe ownership/uncertain writes propagate to wake quarantine; no fabricated rejection acknowledgment. Historical B12 hashes and absent feedback decode retained.",
  "monitoring": "Draft criteria only; comparable rainfall, pavement/wear, scheduled+actual pickup/reaccumulation window required by issue. Missing opportunity unresolved; completion never resolution",
  "limits": {
    "tasks": 12,
    "targets_per_task": 5,
    "history_versions": 100,
    "payload_bytes": 90000
  },
  "excluded": [
    "approvals",
    "WorkOrder creation",
    "execution",
    "monitoring evaluation/workers",
    "events/outbox",
    "API/SSE/frontend"
  ],
  "feedback_schema": {
    "additionalProperties": false,
    "properties": {
      "code": {
        "enum": [
          "PLAN_DAG_INVALID",
          "PLAN_SCHEMA_INVALID",
          "PLAN_ACTION_UNSUPPORTED",
          "PLAN_PREREQUISITE_INVALID",
          "PLAN_EVIDENCE_INSUFFICIENT",
          "PLAN_OWNERSHIP_UNAVAILABLE",
          "PLAN_SOURCE_UNAVAILABLE",
          "PLAN_DEPENDENCY_UNAVAILABLE",
          "PLAN_OPERATOR_RECOVERY",
          "PLAN_REFERENCE_INVALID"
        ],
        "title": "Code",
        "type": "string"
      },
      "category": {
        "enum": [
          "DAG",
          "SCHEMA",
          "ACTION",
          "PREREQUISITE",
          "EVIDENCE",
          "OWNERSHIP",
          "SOURCE",
          "DEPENDENCY",
          "RECOVERY",
          "REFERENCE"
        ],
        "title": "Category",
        "type": "string"
      },
      "resolution": {
        "enum": [
          "DRAFT_CLARIFICATION",
          "MISSING_EVIDENCE_OR_CAPABILITY",
          "OPERATOR_RECOVERY"
        ],
        "title": "Resolution",
        "type": "string"
      },
      "task_ids": {
        "items": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "maxItems": 8,
        "title": "Task Ids",
        "type": "array"
      },
      "field_paths": {
        "items": {
          "maxLength": 160,
          "type": "string"
        },
        "maxItems": 8,
        "title": "Field Paths",
        "type": "array"
      },
      "explanation": {
        "maxLength": 240,
        "title": "Explanation",
        "type": "string"
      },
      "draft_committed": {
        "default": "NO",
        "enum": [
          "NO",
          "UNKNOWN"
        ],
        "title": "Draft Committed",
        "type": "string"
      }
    },
    "required": [
      "code",
      "category",
      "resolution",
      "explanation"
    ],
    "title": "Feedback",
    "type": "object"
  },
  "action_policies": {
