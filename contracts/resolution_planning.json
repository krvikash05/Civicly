  "remediation_rules": "Latest addressed SUPPORTED/VERIFIED with reviewed target-specific causal support, no contradictions. Supported-now requires typed MET full causal confirmation and action-specific safety observations through validated B09 reports. Conditional causal gap requires explicit UNMET and inspection DAG dependency; unmet safety remains unresolved. Procedure source is documentary, PROPOSED, not physical causal evidence. No execution authority.",
  "hash_compatibility": "Absent remediation omitted from normalized old inspection drafts; existing B12 accepted hashes unchanged. Conditions and their evidence normalize deterministically.",
  "source_manifest": "data/documents/b12r/manifest.json; three version1 synthetic policies with explicit automated author self-review only; B11 KnowledgeProcedure stays PROPOSED",
  "responsibility_acquisition": "Explicit independently reviewed synthetic inventory via contracts/responsibility.json; candidate remains immutable; new drafts bind relationship/evidence hashes, operations reject changed ownership bindings; source/procedure/safety remain independent",
  "utility_dependencies": {
    "ISOLATION_PROOF": "Immutable UNMET prerequisite bound to exact utility isolation predecessor; persisted independently reviewed completion required at order/assignment/start",
    "UTILITY_VERIFICATION": "Immutable UNMET prerequisite bound to exact utility repair predecessor on reviewed UNDERLIES pipe/road topology; independently dated utility verification required at order/assignment/start",
    "authority": "Synthetic proposed guidance and DAG never authorize execution; current evidence, ownership, procedure, exact approval and assignee required",
    "single_predecessor_limit": {
      "scope": "At most one UTILITY_LEAK_REPAIR task linked through bounded verified UNDERLIES topology to any target of one road task",
      "blocker_code": "UTILITY_MULTIPLE_REPAIR_PREDECESSORS",
      "exact_binding": "The sole linked repair must be both the UTILITY_VERIFICATION predecessor and exact depends_on task; each road target must be linked",
      "revalidation": "The same policy is rerun with current topology before new authority; no historical draft/approval rewrite",
      "unsupported": "Multiple relevant repair tasks fail closed; no selection, omission or general multi-predecessor schema"
    }
  }
}
