{
  "version": "B12R-1",
  "municipality_id": "demo-city",
  "execution_authority": false,
  "draft_schema": {
    "$defs": {
      "Basis": {
        "additionalProperties": false,
        "properties": {
          "hypothesis_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Hypothesis Id",
            "type": "string"
          },
          "assessment_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Assessment Id",
            "type": "string"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "addressed": {
            "title": "Addressed",
            "type": "boolean"
          }
        },
        "required": [
          "hypothesis_id",
          "assessment_id",
          "reason",
          "addressed"
        ],
        "title": "Basis",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "source_document_id": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Source Document Id",
            "type": "string"
          },
          "source_version": {
            "minimum": 1,
            "title": "Source Version",
            "type": "integer"
          },
          "canonical_document_id": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Canonical Document Id",
            "type": "string"
          },
          "owner_department_id": {
            "title": "Owner Department Id",
            "type": "string"
          },
          "source_uri": {
            "maxLength": 512,
            "title": "Source Uri",
            "type": "string"
          },
          "content_checksum": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Checksum",
            "type": "string"
          },
          "quote_excerpt": {
            "maxLength": 800,
            "minLength": 1,
            "title": "Quote Excerpt",
            "type": "string"
          },
          "passage_location": {
            "pattern": "^chunk:[0-9]+:[a-f0-9-]{36}$",
            "title": "Passage Location",
            "type": "string"
          },
          "chunk_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Chunk Sha256",
            "type": "string"
          },
          "confidence_label": {
            "enum": [
              "SOURCE_REVIEWED_SYNTHETIC",
              "PROPOSED",
              "DISPUTED"
            ],
            "title": "Confidence Label",
            "type": "string"
          },
          "assertion_status": {
            "const": "PROPOSED",
            "default": "PROPOSED",
            "title": "Assertion Status",
            "type": "string"
          },
          "retrieved_at": {
            "title": "Retrieved At",
            "type": "string"
          },
          "effective_from": {
            "title": "Effective From",
            "type": "string"
          },
          "derived_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Derived From"
          },
          "trusted_as_instructions": {
            "const": false,
            "default": false,
            "title": "Trusted As Instructions",
            "type": "boolean"
          }
        },
        "required": [
          "source_document_id",
          "source_version",
          "canonical_document_id",
          "owner_department_id",
          "source_uri",
          "content_checksum",
          "quote_excerpt",
          "passage_location",
          "chunk_sha256",
          "confidence_label",
          "retrieved_at",
          "effective_from"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Monitoring": {
        "additionalProperties": false,
        "properties": {
          "issue": {
            "enum": [
              "WATERLOGGING",
              "ROAD_DAMAGE",
              "WASTE_ACCUMULATION"
            ],
            "title": "Issue",
            "type": "string"
          },
          "required_evidence": {
            "items": {
              "enum": [
                "COMPARABLE_FOLLOWUP_RAINFALL",
                "FOLLOWUP_WATERLOGGING",
                "FOLLOWUP_PAVEMENT",
                "WEAR_EXPOSURE",
                "SCHEDULED_PICKUPS",
                "ACTUAL_PICKUPS",
                "REACCUMULATION_WINDOW"
              ],
              "type": "string"
            },
            "maxItems": 7,
            "minItems": 2,
            "title": "Required Evidence",
            "type": "array"
          },
          "observation_opportunity": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Observation Opportunity",
            "type": "string"
          },
          "verification_criteria": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Verification Criteria",
            "type": "string"
          },
          "missing_opportunity": {
            "const": "UNRESOLVED",
            "default": "UNRESOLVED",
            "title": "Missing Opportunity",
            "type": "string"
          },
          "completion_implies_resolution": {
            "const": false,
            "default": false,
            "title": "Completion Implies Resolution",
            "type": "boolean"
          }
        },
        "required": [
          "issue",
          "required_evidence",
          "observation_opportunity",
          "verification_criteria"
        ],
        "title": "Monitoring",
        "type": "object"
      },
      "Prerequisite": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "CAUSAL_INSPECTION",
              "SAFETY_REVIEW",
              "ISOLATION_PROOF",
              "UTILITY_VERIFICATION"
