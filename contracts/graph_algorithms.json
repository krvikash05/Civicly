  "semantics": {
    "max_hops": "total edges of each returned graph path; shared downstream AFFECTS consumes1, no implicit expansion",
    "physical_default": "VERIFIED plus dated attributed evidence; explicit candidate mode allows VERIFIED/CANDIDATE/REPORTED",
    "topology": "DRAINS_TO for reachability/impact/criticality/shared; DRAINS_TO|UNDERLIES|COLLECTED_BY for dependency and bounded weak component context; no LOCATED_AT-derived physical connection",
    "criticality": "distinct reachable downstream infrastructure assets within budget, excluding origin; rank descending count then stable ID; not causal confidence",
    "shared": "distinct selected incidents reaching asset within total-hop budget; rank coverage descending then maximum path hops ascending then stable ID",
    "components": "weak components of induced bounded export; direction ignored only for component membership, not physical flow",
    "dag": "DEPENDS_ON dependent->prerequisite; Kahn prerequisites first; only exported DAG validated, external/unexported context qualified",
    "case_ranking": [
      "shared_asset_count DESC",
      "drainage_dependency_asset_count DESC",
      "shared_cluster_count DESC",
      "same_zone DESC",
      "same_issue DESC",
      "started_at DESC",
      "id ASC"
    ],
    "case_filters": "explicit issue/zone/after/before filters; seed-derived issue/zone are ranking context; historical upper bound min(before,seed.started_at); no inferred resolution from asset context",
    "case_paths": "each factor path separately bounded; drainage neighborhood subtracts candidate AFFECTS1 and optional seed AFFECTS1; independently returned zone/cluster paths are not concatenated into invented connections",
    "truncated": "path/node/edge/row caps; counts/ranks lower bounds; separate from hop/time/proof limitations",
    "search_limited": "always true for these bounded primitives; empty does not prove global absence",
    "read_consistency": "pre/post revision and pending-state checks; at most2 attempts within shared query/wall/compute budgets; privileged raw writers outside general revision guarantee",
    "counterfactual": "fresh factory-owned B05 UUID clone, complete120node/200edge snapshot; repo-fenced CAS/intent/audit removal of verified DRAINS_TO only and explicit candidate addition; source fingerprint unchanged; no city evidence promotion",
    "product_boundary": "internal primitives, not MCP envelopes, causal verdicts, memory, plans or operational workflows"
  },
  "dependencies_not_completed": [
    "B06/B07 MCP and trace contracts",
    "B08 recurrence/source associations",
    "B09 physical evidence/hypotheses",
    "B11 source ownership/version/PDF",
    "B19 binding/history/release/runtime isolation"
  ]
}
