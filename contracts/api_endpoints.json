  "envelope": {
    "success": [
      "data",
      "request_id",
      "schema_version"
    ],
    "error": [
      "error",
      "request_id"
    ]
  },
  "sse_cursor": "durable monotonically sortable event_id; Last-Event-ID with replay/refetch semantics",
  "dto_contracts": {
    "GraphSubgraphDTO": {
      "required": [
        "nodes",
        "edges",
        "decision_path_ids",
        "graph_revision",
        "truncated",
        "as_of"
      ],
      "bounds": {
        "nodes": 120,
        "edges": 200,
        "hops": 6
      }
    },
    "HypothesisDTO": {
      "required": [
        "id",
        "cause_code",
        "assessment_history",
        "supporting_evidence_ids",
        "contradicting_evidence_ids",
        "missing_evidence"
      ]
    },
    "AgentTraceEvent": {
      "required": [
        "event_id",
        "investigation_id",
        "agent_role",
        "timestamp",
        "tool_name",
        "status",
        "rationale_summary"
      ]
    },
    "PlanDTO": {
      "required": [
        "plan_id",
        "version",
        "content_hash",
        "tasks",
        "dependencies",
        "status",
        "simulated",
        "monitoring_criteria"
      ]
    }
  },
  "municipality_scope": {
    "field": "municipality_id",
    "value": "demo-city",
    "mode": "single_synthetic_municipality",
    "caller_selectable": false,
    "framework_tenant_id_mapping": "explicit boundary adapter only; never a domain property"
  }
}
