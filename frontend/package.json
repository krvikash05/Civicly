{
  "name": "civicly-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "contracts": "python3 scripts/check_contracts.py",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "test": "node --experimental-strip-types --test tests/transport.test.ts tests/cases.test.ts tests/canvas-adapter.test.ts tests/sse.test.ts tests/plans.test.ts tests/memory.test.ts tests/journeys.test.ts tests/display.test.ts",
    "prebuild": "npm run check:api && npm run contracts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@falkordb/canvas": "^0.3.3",
    "ajv": "8.20.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  },
  "type": "module"
}
