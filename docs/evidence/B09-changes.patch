@@ -0,0 +1,36 @@
+"""Explicit synthetic demonstration criteria; observations never self-authenticate."""
+POLICIES = {
+    'WATERLOGGING': {
+        'BLOCKAGE': {'confirming': ['OBSTRUCTION_OBSERVED', 'FLOW_RESTRICTED'], 'falsifying': ['DRAIN_CLEAR']},
+        'CAPACITY_DEFICIT': {'confirming': ['CAPACITY_TEST_EXCEEDED', 'DRAIN_CLEAR'], 'falsifying': ['CAPACITY_ADEQUATE']},
+        'PUMP_FAILURE': {'confirming': ['PUMP_FAILURE_OBSERVED', 'POWER_TEST_FAILED'], 'falsifying': ['PUMP_TEST_NORMAL']},
+    },
+    'ROAD_DAMAGE': {
+        'UTILITY_LEAK': {'confirming': ['LEAK_DETECTED', 'INFILTRATION_AT_DAMAGE'], 'falsifying': ['PRESSURE_TEST_NORMAL']},
+        'SUBGRADE_FAILURE': {'confirming': ['SUBGRADE_FAILURE_OBSERVED', 'STRUCTURAL_TEST_FAILED'], 'falsifying': ['SUBGRADE_TEST_NORMAL']},
+    },
+    'WASTE_ACCUMULATION': {
+        'MISSED_PICKUP': {'confirming': ['PICKUP_MISSED_CONFIRMED', 'WASTE_PERSISTED_AFTER_SCHEDULE'], 'falsifying': ['PICKUP_COMPLETED_CONFIRMED']},
+        'CAPACITY_SHORTFALL': {'confirming': ['BIN_CAPACITY_EXCEEDED', 'EXPECTED_PICKUPS_COMPLETED'], 'falsifying': ['CAPACITY_ADEQUATE']},
+        'ILLEGAL_DUMPING': {'confirming': ['DUMPING_OBSERVED', 'UNSCHEDULED_DEPOSIT_OBSERVED'], 'falsifying': ['SCHEDULED_ACCUMULATION_ONLY']},
+    },
+}
+
+ASSET_LABELS = {'BLOCKAGE': ['DrainInlet', 'DrainSegment'], 'CAPACITY_DEFICIT': ['DrainInlet', 'DrainSegment'],
+                'PUMP_FAILURE': ['PumpStation'], 'UTILITY_LEAK': ['WaterPipe'], 'SUBGRADE_FAILURE': ['RoadSegment'],
+                'MISSED_PICKUP': ['WasteCollectionPoint'], 'CAPACITY_SHORTFALL': ['WasteCollectionPoint'],
+                'ILLEGAL_DUMPING': ['WasteCollectionPoint']}
+for rules in POLICIES.values():
+    for cause, rule in rules.items():
+        rule['asset_labels'] = ASSET_LABELS[cause]
+        rule['requires_topology'] = cause == 'UTILITY_LEAK'
+
+
+def classify(*, support, contradiction, reviewed, sufficient):
+    if support and contradiction:
+        return 'INCONCLUSIVE'
+    if contradiction:
+        return 'CONTRADICTED'
+    if support:
+        return 'VERIFIED' if sufficient else 'SUPPORTED' if reviewed else 'POSSIBLE'
+    return 'INCONCLUSIVE'
diff --git a/backend/app/services/evidence/reader.py b/backend/app/services/evidence/reader.py
new file mode 100644
index 0000000..5169c9b
--- /dev/null
+++ b/backend/app/services/evidence/reader.py
@@ -0,0 +1,163 @@
+"""Bounded canonical reads; reuse B03 timing and B05 graph algorithms."""
+import json
+import time
+from app.graph.models import PathRecord, digest
+from app.graph.queries import GraphQueries
+from app.graph.repository import PreconditionFailed
+from app.graph.schema import timestamp
+from app.graph.analysis.engine import GraphAnalysis
+from app.graph.analysis.models import AnalysisRequest, CaseRequest
+from .models import Journal, Report, EvidenceReference, Propose
+
+EDGE_KINDS = {'PART_OF', 'AFFECTS', 'INVESTIGATES', 'PROPOSES', 'CONCERNS', 'EXPLAINS',
+              'HAS_ASSESSMENT', 'INSPECTS', 'PRODUCED', 'ESTABLISHES', 'SUPPORTED_BY', 'CONTRADICTED_BY'}
+
+
+class Reader:
+    def __init__(self, repo, as_of):
+        self.repo, self.as_of = repo, as_of
+        self.cache = {}
+        self.queries = 0
+        self.started = time.perf_counter()
+
+    def query(self, query, params=None):
+        self.queries += 1
+        if self.queries > 300 or time.perf_counter() - self.started > 8:
+            raise PreconditionFailed('B09 read budget exceeded')
+        return self.repo._read(query, {'scope': self.repo.registry.scope, **(params or {})})
+
+    def visible(self, props, *, definition=False):
+        at = timestamp(self.as_of)
+        fields = ['created_at', 'observed_at', 'recorded_at', 'requested_at', 'completed_at', 'assessed_at', 'started_at']
+        if not definition:
+            fields.append('updated_at')
+        return (all(timestamp(props[k]) <= at for k in fields if k in props)
+                and ('valid_from' not in props or timestamp(props['valid_from']) <= at)
+                and ('valid_to' not in props or at < timestamp(props['valid_to'])))
+
+    def node(self, id, kind=None, *, definition=False):
+        if id not in self.cache:
+            rows = self.query('MATCH (n:CivicEntity {id:$id,municipality_id:$scope}) RETURN labels(n),properties(n) LIMIT 2', {'id': id})
+            if len(rows) != 1:
+                raise PreconditionFailed('Unique B09 reference unavailable')
+            self.cache[id] = self.repo.decode_node(*rows[0])
+        n = self.cache[id]
+        if (kind and kind not in n.labels) or not self.visible(n.properties, definition=definition):
+            raise PreconditionFailed('B09 reference type/time unavailable')
+        return n
+
+    def edges(self, kind, source=None, target=None):
+        if kind not in EDGE_KINDS:
+            raise PreconditionFailed('Unapproved B09 read family')
+        rows = self.query(f'MATCH (s:CivicEntity)-[e:{kind}]->(t:CivicEntity) WHERE e.municipality_id=$scope AND ($source IS NULL OR s.id=$source) AND ($target IS NULL OR t.id=$target) RETURN type(e),properties(e),labels(s),properties(s),labels(t),properties(t) LIMIT 101',
+                          {'source': source, 'target': target})
+        if len(rows) > 100:
+            raise PreconditionFailed('B09 relationship scan exceeds100; incomplete evidence cannot verify')
+        result = []
+        for row in rows:
+            e = self.repo._decode_edge_row(row)
+            if not self.visible(e.properties):
+                continue
+            ev = e.properties.get('source_evidence_id')
+            if ev:
+                self.node(ev, 'Evidence')
+            result.append(e)
+        return result
+
+    def definition(self, hypothesis_id):
+        h = self.node(hypothesis_id, 'Hypothesis', definition=True)
+        proposals = self.edges('PROPOSES', target=h.id)
+        if len(proposals) != 1:
+            raise PreconditionFailed('Unique proposal source required')
+        journal = self.journal(proposals[0].properties['source_evidence_id'])
+        if journal.state != 'COMMITTED' or journal.command['operation'] != 'propose' or journal.receipt.entity_id != h.id:
+            raise PreconditionFailed('Proposal journal binding mismatch')
+        q = Propose.model_validate_json(json.dumps(journal.command))
+        if q.investigation_id != proposals[0].source or q.cause_code != h.properties['cause_code'] or q.statement != h.properties['statement']:
+            raise PreconditionFailed('Hypothesis definition changed outside domain service')
+        return h, q
+
+    def journal(self, id):
+        ev = self.node(id, 'Evidence')
+        j = Journal.model_validate_json(ev.properties['summary'])
+        if (ev.properties['evidence_type'] != 'B09_OPERATION' or ev.properties['reliability'] != 'UNVERIFIED'
+                or digest({'actor': j.actor.model_dump(mode='json'), 'command': j.command}) != j.request_hash
+                or j.state != 'COMMITTED' or j.receipt.journal_id != id or j.receipt.graph != self.repo.graph.name):
+            raise PreconditionFailed('B09 journal hash/scope/receipt mismatch')
+        return j
+
+    def evidence(self, id, *, context_only=False):
+        ev = self.node(id, 'Evidence')
+        p = ev.properties
+        if not p.get('source_record_id'):
+            raise PreconditionFailed('Evidence lacks attributed source record')
+        ref = EvidenceReference(id=id, content_hash=ev.content_hash, source_kind=p['source_kind'],
+                                source_record_id=p['source_record_id'], reliability=p['reliability'],
+                                observed_at=p.get('observed_at'), recorded_at=p['recorded_at'], basis=p.get('basis'))
+        if context_only or p['evidence_type'] != 'INSPECTION_REPORT' or p.get('basis') != 'OBSERVED':
+            return ref
+        report = Report.model_validate_json(p['summary'])
+        if (digest(json.loads(p['summary'])) != p.get('content_hash')
+                or report.source_kind != p['source_kind']
+                or p['source_record_id'] != report.source_id + ':' + report.record_id
+                or p.get('observed_at') != report.observed_at or p['recorded_at'] != report.recorded_at
+                or len(report.finding_ids) != len(report.observations)):
+            raise PreconditionFailed('Inspection report provenance/hash mismatch')
+        ins = self.node(report.inspection_id, 'Inspection')
+        if ins.properties['status'] != 'COMPLETED' or ins.properties.get('completed_at') != report.observed_at:
+            raise PreconditionFailed('Actual completed inspection required')
+        produced = [e for e in self.edges('PRODUCED', source=ins.id) if e.target == id]
+        if len(produced) != 1:
+            raise PreconditionFailed('Report is not produced by the declared inspection')
+        journal = self.journal(produced[0].properties['source_evidence_id'])
+        original = journal.command
+        if (original['operation'] != 'report_inspection' or journal.receipt.entity_id != id
+                or journal.actor.id != report.inspector_id or original['inspection_id'] != ins.id
+                or original['source_id'] != report.source_id or original['record_id'] != report.record_id
+                or original['source_kind'] != report.source_kind
+                or original['observations'] != [ob.model_dump(mode='json') for ob in report.observations]
+                or original['review'] != (report.review.model_dump(mode='json') if report.review else None)):
+            raise PreconditionFailed('Report disagrees with original attributed operation')
+        assets = {e.target for e in self.edges('INSPECTS', source=ins.id)}
+        established = {e.target for e in self.edges('ESTABLISHES', source=id)}
+        if established != set(report.finding_ids):
+            raise PreconditionFailed('Report finding relationships mismatch')
+        hashes = {}
+        for fid, ob in zip(report.finding_ids, report.observations, strict=True):
+            finding = self.node(fid, 'Finding')
+            expected = 'VERIFIED' if report.review and ob.result == 'OBSERVED' else 'UNVERIFIED'
+            if ob.asset_id not in assets or finding.properties['statement'] != ob.statement or finding.properties['finding_type'] != ob.code or finding.properties['verification_status'] != expected:
+                raise PreconditionFailed('Attributable finding/asset mismatch')
+            if timestamp(ob.observed_at) > timestamp(report.observed_at) or timestamp(ob.observed_at) < timestamp(ins.properties['requested_at']):
+                raise PreconditionFailed('Inspection observation chronology mismatch')
+            hashes[fid] = finding.content_hash
+        if p['reliability'] != ('VERIFIED' if report.review else 'UNVERIFIED'):
+            raise PreconditionFailed('Review and evidence reliability mismatch')
+        return ref.model_copy(update={'report': report, 'finding_hashes': hashes})
+
+    def topology(self, topology, *, exploratory=False):
+        return GraphAnalysis(self.repo).run(AnalysisRequest(operation=topology.operation,
+            ids=(topology.source_id,), as_of=self.as_of, max_hops=topology.max_hops,
+            include_candidates=exploratory, limit=100))
+
+    def histories(self, hypothesis_id):
+        key = GraphQueries._time_key
+        rows = self.query('MATCH (h:Hypothesis {id:$id})-[:HAS_ASSESSMENT]->(a:HypothesisAssessment) WHERE a.municipality_id=$scope AND '
+            + key('a.created_at') + '<=$at AND ' + key('a.assessed_at')
+            + '<=$at RETURN a.id,a.rationale ORDER BY ' + key('a.assessed_at') + ',a.id LIMIT 101',
+            {'id': hypothesis_id, 'at': timestamp(self.as_of).strftime('%Y-%m-%dT%H:%M:%S.%f')})
+        if len(rows) > 100:
+            raise PreconditionFailed('B09 assessment history exceeds100; no hidden latest record')
+        from .models import Assessment
+        result = []
+        for id, raw in rows:
+            value = Assessment.model_validate_json(raw)
+            n = self.node(id, 'HypothesisAssessment')
+            if value.id != id or value.hypothesis_id != hypothesis_id or value.assessment != n.properties['assessment']:
+                raise PreconditionFailed('Assessment history binding mismatch')
+            result.append(value)
+        return sorted(result, key=lambda value: (timestamp(value.assessed_at), value.graph_revision, value.id))
+
+    def cases(self, incident_id, *, exploratory=False):
+        return GraphAnalysis(self.repo).cases(CaseRequest(seed_incident_id=incident_id, as_of=self.as_of,
+                                                        include_candidates=exploratory, limit=40))
diff --git a/backend/app/services/evidence/service.py b/backend/app/services/evidence/service.py
new file mode 100644
index 0000000..ad30096
--- /dev/null
+++ b/backend/app/services/evidence/service.py
@@ -0,0 +1,391 @@
+"""Trusted B09 domain service. No MCP writes, dispatch, agent, or event delivery."""
+import json
+from pathlib import Path
+from app.graph.models import digest, PathRecord
+from app.graph.queries import GraphQueries
+from app.graph.repository import Conflict, PreconditionFailed
+from app.graph.schema import utc_now, timestamp
+from .models import (Actor, Journal, Receipt, Report, Assessment, parse_command,
+                     OpenInvestigation, Propose, RequestInspection, TransitionInspection, ReportInspection, Assess, InspectionView)
+from .policies import POLICIES, classify
+from .reader import Reader
+from .writer import target, common, node, link, stable, commit
+
+MACHINES = json.loads((Path(__file__).resolve().parents[4] / 'contracts/state_machines.json').read_text())['machines']
+
+
+def transition(kind, old, new):
+    if new not in MACHINES[kind]['transitions'].get(old, []):
+        raise PreconditionFailed('Illegal domain state transition')
+    return new
+
+
+class EvidenceService:
+    def __init__(self, repository, *, clock=utc_now):
+        self.repo, self.clock = repository, clock
+
+    def load(self, id, sha):
+        n = self.repo._node_optional(id)
+        if n is None:
+            return None, None
+        if n.kind != 'Evidence' or n.properties['evidence_type'] != 'B09_OPERATION' or n.properties['reliability'] != 'UNVERIFIED':
+            raise Conflict('B09 journal identity/type collision')
+        j = Journal.model_validate_json(n.properties['summary'])
+        if j.request_hash != sha or digest({'actor': j.actor.model_dump(mode='json'), 'command': j.command}) != sha:
+            raise Conflict('Request ID reused with different command/actor')
+        return n, j
+
+    def readback(self, receipt, replayed=False):
+        if receipt.graph != self.repo.graph.name:
+            raise PreconditionFailed('Receipt graph mismatch')
+        for id in [receipt.entity_id, *receipt.created_ids, *receipt.updated_ids]:
+            self.repo.get_node(id)
+        for id in receipt.relationship_ids:
+            self.repo.get_relationship(id)
+        if receipt.assessment:
+            actual = self.repo.get_node(receipt.assessment.id, 'HypothesisAssessment')
+            if Assessment.model_validate_json(actual.properties['rationale']) != receipt.assessment:
+                raise PreconditionFailed('Immutable assessment readback mismatch')
+            supported = {e.target for e in Reader(self.repo, receipt.recorded_at).edges('SUPPORTED_BY', source=actual.id)}
+            contradicted = {e.target for e in Reader(self.repo, receipt.recorded_at).edges('CONTRADICTED_BY', source=actual.id)}
+            if supported != set(receipt.assessment.supporting_evidence_ids) or contradicted != set(receipt.assessment.contradicting_evidence_ids):
+                raise PreconditionFailed('Assessment evidence relationships mismatch')
+            for p in receipt.assessment.paths:
+                for i, id in enumerate(p.edge_ids):
+                    e = self.repo.get_relationship(id)
+                    ends = (e.source, e.target) if p.directions[i] == 'OUTGOING' else (e.target, e.source)
+                    if ends != (p.node_ids[i], p.node_ids[i+1]):
+                        raise PreconditionFailed('Assessment path readback mismatch')
+        return receipt.model_copy(update={'replayed': replayed})
+
+    def execute(self, payload, actor):
+        target(self.repo)
+        if not isinstance(actor, Actor):
+            raise TypeError('Trusted typed actor required; not public authentication')
+        q = parse_command(payload)
+        self.authorize(q, actor)
+        now = self.clock()
+        timestamp(now)
+        canonical = q.model_dump(mode='json')
+        sha = digest({'actor': actor.model_dump(mode='json'), 'command': canonical})
+        jid = stable('EV-JOURNAL', actor.id, q.request_id)
+        old, journal = self.load(jid, sha)
+        if not old:
+            journal = Journal(request_hash=sha, actor=actor, command=canonical)
+            try:
+                self.repo.create_node('Evidence', {**common(jid, now), 'evidence_type': 'B09_OPERATION',
+                    'summary': journal.serialized(), 'reliability': 'UNVERIFIED', 'recorded_at': now,
+                    'source_kind': 'USER', 'source_record_id': actor.id + ':' + q.request_id})
+            except Conflict:
+                self.load(jid, sha)  # Equal concurrent prepare only; unknown outcomes never retried.
+        with self.repo._session() as session:
+            old, journal = self.load(jid, sha)
+            if journal.state == 'COMMITTED':
+                return self.readback(journal.receipt, True)
+            q = parse_command(journal.command)
+            now = self.clock()
+            reader = Reader(self.repo, now)
+            entity, nodes, updates, edges, assessment = self.plan(q, actor, reader, jid, now, session.revision)
+            receipt = Receipt(operation=q.operation, journal_id=jid, entity_id=entity, graph=self.repo.graph.name,
+                graph_revision=session.revision + 1, recorded_at=now, created_ids=[n.id for n in nodes],
+                relationship_ids=[e.id for e in edges], updated_ids=[n.id for n in updates], assessment=assessment)
+            saved = journal.model_copy(update={'state': 'COMMITTED', 'receipt': receipt})
+            commit(self.repo, session, old, nodes, updates, edges, saved.serialized(), now)
+        _, saved = self.load(jid, sha)
+        if saved.state != 'COMMITTED':
+            raise PreconditionFailed('B09 receipt was not committed')
+        return self.readback(saved.receipt)
+
+    @staticmethod
+    def authorize(q, actor):
+        allowed = {'ANALYST', 'ADMIN'} if isinstance(q, (OpenInvestigation, Propose, Assess)) else {'ANALYST', 'DEPARTMENT_LEAD', 'ADMIN'}
+        if isinstance(q, ReportInspection) or (isinstance(q, TransitionInspection) and q.status != 'REQUESTED'):
+            allowed = {'DEPARTMENT_LEAD', 'ADMIN'}
+        if actor.role not in allowed:
+            raise PreconditionFailed('Role cannot perform this B09 operation')
+        if actor.role == 'DEPARTMENT_LEAD' and not actor.department_id:
+            raise PreconditionFailed('Department actor scope required')
+
+    def inspection_source(self, reader, id):
+        edges = reader.edges('INSPECTS', source=id)
+        sources = {e.properties.get('source_evidence_id') for e in edges}
+        if len(sources) != 1 or None in sources:
+            raise PreconditionFailed('Unique inspection request source required')
+        j = reader.journal(next(iter(sources)))
+        if j.state != 'COMMITTED' or j.command['operation'] != 'request_inspection' or j.receipt.entity_id != id:
+            raise PreconditionFailed('Inspection request binding mismatch')
+        return j.command, {e.target for e in edges}
+
+    def plan(self, q, actor, r, jid, now, revision):
+        n = lambda kind, props: node(self.repo, kind, props)
+        edge = lambda kind, s, t: link(kind, s, t, jid, now)
+        if isinstance(q, OpenInvestigation):
+            r.node(q.cluster_id, 'ProblemCluster')
+            for id in q.incident_ids:
+                r.node(id, 'Incident')
+                if not any(e.target == q.cluster_id for e in r.edges('PART_OF', source=id)):
+                    raise PreconditionFailed('Incident must have the specified active primary cluster')
+            id = stable('INV', jid)
+            inv = n('Investigation', {**common(id, now), 'status': 'OPEN', 'priority': q.priority, 'opened_at': now, 'graph_revision': revision})
+            return id, [inv], [], [edge('INVESTIGATES', id, t) for t in [q.cluster_id, *q.incident_ids]], None
+        if isinstance(q, Propose):
+            r.node(q.investigation_id, 'Investigation')
+            bound = {e.target for e in r.edges('INVESTIGATES', source=q.investigation_id)}
+            if not set(q.incident_ids) <= bound:
+                raise PreconditionFailed('Hypothesis incidents outside investigation')
+            incidents = [r.node(id, 'Incident') for id in q.incident_ids]
+            issues = {i.properties['issue_type'] for i in incidents}
+            if len(issues) != 1:
+                raise PreconditionFailed('One hypothesis issue; use competing hypotheses across categories')
+            issue = next(iter(issues))
+            rule = POLICIES[issue].get(q.cause_code)
