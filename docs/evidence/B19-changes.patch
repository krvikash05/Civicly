+{
+  "version": 1,
+  "decision": "DEC-065",
+  "definition_file": "data/scenarios/runtime-v1.json",
+  "evaluator_only": ["contracts/scenarios/catalog.json", "data/scenarios/hidden_truth.json", "data/scenarios/event_reveals.json"],
+  "public_catalog": "Neutral Demonstration Snn titles, issue categories, actual returned case IDs/current stage and generic next steps only; no answers/preferred tools/evaluator criteria/future packets",
+  "scope": "Fresh host-generated ActiveProfile plus private memory/world profile; retain previous source, city, checkpoints and quarantines",
+  "reset_role": "ADMIN",
+  "advance_role": "ADMIN",
+  "release_authority": "Actual independently authenticated DEPARTMENT_LEAD for the bound inspection department, plus ANALYST reviewer; ADMIN coordinates without impersonation",
+  "stages": ["BASELINE_VISIBLE", "EVIDENCE_REVEALED", "PLAN_AND_APPROVAL", "FOLLOW_UP"],
+  "evidence_release": "B09 typed report, actual IN_PROGRESS inspection, exact hash/target/case/department/time binding, attributed occurrence, authenticated review; no hypothesis/assessment/plan/action/outcome manufactured",
+  "partial_release": "One bound case/inspection per call; multiple-category global stage advances only when all actual case packets are committed",
+  "recovery": "Existing B16 transport DISPATCHING intent plus existing graph companion reservation; exact uncertain replay blocked, safe IDs, no redispatch/repair/quarantine clearance",
+  "unsupported_interventions": ["utility leak repair/isolation", "capacity upgrades/route redesign", "dumping-management signage/enforcement"],
+  "supported_remedial_actions": ["DRAIN_BLOCKAGE_CLEARANCE", "SUBGRADE_REPAIR", "MISSED_PICKUP_RECOVERY"],
+  "limits": "12 strict definitions,2 variants each,1..3 case scopes,1..10 observations per packet; no arbitrary graph/file/tool/shell/clock/provider selector",
+  "provider_policy": "No provider construction or call; optional explicit B18 worker remains labelled deterministic development ReadPause",
+  "verification_boundary": "B19 proves mechanics/isolation; B20–B22 prove decisions/ablation/history/restarts; B23 requires separate genuine-provider authorization"
+}
