+     r={**r,'status':'CLAIMED','attempts':r['attempts']+1,'owner':owner,'token':token,'lease_until':later(now,lease_seconds),'batch':key,'history':[*r['history'],{'at':now,'status':'CLAIMED','owner':owner,'attempt':r['attempts']+1}]}
