+    with os.fdopen(fd,'w') as f:json.dump(value,f)
+
+def load(path=DEFAULT_PROFILE):
+    path=Path(path)
+    if path.is_symlink() or not path.is_file() or path.stat().st_mode&0o077:raise ValueError('Private regular profile required')
