+        asset_ids=[{'WATERLOGGING':'D1','ROAD_DAMAGE':'R1','WASTE_ACCUMULATION':'W1'}[issue]],issue=issue,
+        graph_revision=GraphQueries(r)._state(),inventory_hash=tools.inventory_hash,as_of=clock())
