+        s.graph_revision=self.revision();return self.output(s,'Supervisor')
+    def begin(self,s):
+        self.check()
+        if self.revision()!=s.graph_revision:raise RecoveryRequired('SOURCE_CHANGED_BEFORE_ACTION')
+        if not s.decisions:raise ValueError('Durable decision missing')
+        id=identity('EV',s.thread_id,s.iterations,s.wakes)
+        fresh=self.control.journal(id)[0] is None
+        node,value=self.control.prepare(id,s.decisions[-1],s.selection)
+        return node,value,fresh
+    def compact(self,value):
+        # Bounded public result summaries retain actual provenance and limitations.
+        text=json.dumps(value,sort_keys=True)
+        if len(text.encode())<=18000:return value
+        return {'status':value.get('status'),'graph_revision':value.get('graph_revision'),'source_evidence_ids':value.get('source_evidence_ids',[])[:100],
+            'truncated':True,'search_limited':True,'gaps':value.get('data',{}).get('gaps',[]),'summary_limit':'Full output validated by broker; summary capped at 18KB, retrieve targeted evidence before conclusions',
+            'paths':value.get('data',{}).get('paths',[])[:4]}
