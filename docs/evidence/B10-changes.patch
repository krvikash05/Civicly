+"""Live Gemini structured outputs. No default fake provider or prerecorded responses."""
+import json
+from pathlib import Path
+import httpx
+from pydantic import Field,SecretStr
+from pydantic_settings import BaseSettings,SettingsConfigDict
+from .models import Selection
+
+PROMPT_VERSION='B10-2'
+PROMPT=(Path(__file__).parent/'prompts/B10-2.txt').read_text()
+
+class ProviderSettings(BaseSettings):
+    model_config=SettingsConfigDict(extra='ignore',hide_input_in_errors=True)
+    provider: str=Field(default='gemini',validation_alias='CIVICLY_LLM_PROVIDER')
+    model: str=Field(default='gemini-3.8-flash',validation_alias='CIVICLY_LLM_MODEL',pattern=r'^[A-Za-z0-9._-]{1,100}$')
+    key: SecretStr=Field(validation_alias='GEMINI_API_KEY')
+    timeout: float=Field(default=45,ge=1,le=60,validation_alias='CIVICLY_LLM_TIMEOUT')
+
+class ProviderError(RuntimeError):pass
+
+class Gemini:
+    mode='LIVE_GEMINI'
+    def __init__(self,settings):
+        if settings.provider!='gemini':raise ValueError('Unsupported provider; explicit adapter required')
+        self.settings=settings;self.last_usage={}
+    async def choose(self,context,remaining_tokens):
+        self.last_usage={}
+        text=PROMPT+'\nCONTEXT_JSON:\n'+json.dumps(context,sort_keys=True,separators=(',',':'))
+        # Bytes are a conservative input upper bound; reserve output/thought budget.
+        if len(text.encode())+4096>remaining_tokens:raise ProviderError('TOKEN_BUDGET')
+        total=0
+        async with httpx.AsyncClient(timeout=self.settings.timeout,follow_redirects=False) as client:
+            for attempt in range(2):
+                try:
+                    response=await client.post('https://generativelanguage.googleapis.com/v1beta/models/'+self.settings.model+':generateContent',
+                        headers={'x-goog-api-key':self.settings.key.get_secret_value()},json={'contents':[{'role':'user','parts':[{'text':text}]}],
+                        'generationConfig':{'responseMimeType':'application/json','responseJsonSchema':Selection.model_json_schema(),'maxOutputTokens':4096,'thinkingConfig':{'thinkingLevel':'LOW'}}})
+                    if response.status_code!=200:raise ProviderError('PROVIDER_HTTP_'+str(response.status_code))
+                    value=response.json();usage=value.get('usageMetadata',{});used=usage.get('totalTokenCount')
+                    if type(used)is not int or used<1:raise ProviderError('PROVIDER_USAGE_MISSING')
+                    total+=used
+                    self.last_usage={'total_tokens':total,'provider':self.settings.provider,'model':value.get('modelVersion',self.settings.model),'prompt_version':PROMPT_VERSION,'attempts':attempt+1}
+                    if total>remaining_tokens:raise ProviderError('TOKEN_BUDGET')
+                    raw=''.join(p.get('text','') for p in value['candidates'][0]['content']['parts'] if not p.get('thought'))
+                    return Selection.model_validate_json(raw),total
+                except ProviderError:raise
+                except httpx.TimeoutException:raise ProviderError('PROVIDER_TIMEOUT') from None
+                except httpx.HTTPError:raise ProviderError('PROVIDER_TRANSPORT') from None
+                except Exception:
+                    if attempt or total+len(text.encode())+4096>remaining_tokens:raise ProviderError('INVALID_MODEL_OUTPUT') from None
+                    text+='\nPrevious output failed strict validation. Return exactly the supplied schema; do not add fields.'
+        raise ProviderError('INVALID_MODEL_OUTPUT')
