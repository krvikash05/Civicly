+    args={'investigation_id':inv,'asset_id':'P1' if i==0 else 'D1','network':'TYPED_DEPENDENCIES','direction':'DOWNSTREAM','max_hops':3,'as_of':s.as_of,'include_candidates':i==0};name='civicly::trace_infrastructure_dependencies'
