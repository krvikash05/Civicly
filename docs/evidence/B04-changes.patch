+from app.ingestion.importer import Importer,ImportFailure
+from tests.ingestion_examples import source,example,COMPILED
+from tests.graph_fixtures import fixture_graph
+
+pytestmark=pytest.mark.integration
+
+
+@pytest.fixture
+def repo(db):
