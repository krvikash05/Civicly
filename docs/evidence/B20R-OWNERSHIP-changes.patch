+"""B20-R-OWNERSHIP read-only retention/private-artifact audit. Never emits credential values."""
+import hashlib,importlib.metadata,json,re,sqlite3,subprocess,sys
+from pathlib import Path
+root=Path.cwd();base=Path('/tmp/b20r-ownership-baseline');before=json.loads((base/'hashes.json').read_text())
+public=sorted(n for n in subprocess.check_output(['git','ls-files','--cached','--others','--exclude-standard','-z']).decode().split('\0') if n and Path(n).is_file())
+sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
+assert set(before)<=set(public)
+changed=sorted(n for n,h in before.items() if sha(n)!=h);new=sorted(set(public)-set(before))
+trackers={'decision.md','flow.md','implementation_status.md','test_log.md','blockers.md','task_board.md'}
+allowed=trackers|{'backend/cli/main.py','backend/API.md','backend/DEMO.md','backend/OPERATOR_CLI.md','backend/app/api/models.py','backend/app/api/coverage.py','backend/app/graph/repository.py','backend/app/services/http/service.py','backend/app/services/http/reads.py','backend/app/services/http/views.py','backend/app/services/planning/service.py','backend/app/services/operations/service.py','backend/app/services/operations/storage.py','contracts/api_endpoints.json','contracts/api_models.json','contracts/graph_access.json','contracts/operator_cli.json','contracts/resolution_planning.json','docs/backend/02_graph.md','scripts/validate_api.py','scripts/validate_blueprint.py','scripts/validate_handoff.py'}
+assert set(changed)==allowed,(set(changed)^allowed)
+for n in trackers:assert Path(n).read_bytes().startswith((base/'files'/n).read_bytes())
+old_evidence=[n for n in before if n.startswith('docs/evidence/')];old_tests=[n for n in before if n.startswith('backend/tests/')]
+assert not (set(old_evidence)|set(old_tests))&set(changed)
+concurrent_new=[n for n in new if n.startswith('frontend/')]
+concurrent_hashes={n:sha(n) for n in concurrent_new}
+new=[n for n in new if n not in concurrent_new]
+assert {n for n in new if not n.startswith('docs/evidence/B20R-OWNERSHIP-')}=={'backend/RESPONSIBILITY.md','backend/app/services/responsibility/models.py','backend/app/services/responsibility/service.py','backend/tests/integration/test_responsibility_runtime.py','backend/tests/unit/test_responsibility.py','scripts/validate_responsibility.py','contracts/responsibility.json'}
+private=[]
+for line in Path('.env').read_text().splitlines():
+ if '=' in line:
+  k,v=line.split('=',1);v=v.strip(' \"\'')
+  if any(t in k.upper() for t in ['KEY','SECRET','TOKEN','PASSWORD']) and len(v)>7:private.append(v.encode())
+def collect(x):
+ if isinstance(x,dict):
+  for k,v in x.items():
+   if any(t in k.lower() for t in ['password','secret','api_key','token']) and isinstance(v,str) and len(v)>7:private.append(v.encode())
+   else:collect(v)
+ elif isinstance(x,list):
