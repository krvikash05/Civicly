+  key='B16R-'+fault;request=request_identity(p.graph,'OP-ANALYST',key);journal_id=stable('EV-JOURNAL','OP-ANALYST',request)
+  with active_scope(p):before=r._read('MATCH (n:Inspection) RETURN count(n)')[0][0]
