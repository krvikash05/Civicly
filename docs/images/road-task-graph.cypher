MATCH p=(a)-[r]->(b) WHERE (a.id IN ['PIPE-100','PLAN-B12-11e6b8d220e7923a715f5cc0a371b993'] AND type(r) IN ['UNDERLIES','HAS_TASK']) OR (a.id IN ['TASK-B12-8a158819baf845e296daf7a45a4e4065','TASK-B12-8b0208f48c4de3b290ac7a8a36e45040','TASK-B12-cc5b217112ba51340a062ca9fb55853b'] AND type(r) IN ['TARGETS','DEPENDS_ON','ASSIGNED_TO']) OR (b.id IN ['TASK-B12-8a158819baf845e296daf7a45a4e4065','TASK-B12-8b0208f48c4de3b290ac7a8a36e45040','TASK-B12-cc5b217112ba51340a062ca9fb55853b'] AND type(r)='IMPLEMENTS') RETURN p LIMIT 24
